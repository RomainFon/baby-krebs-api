# Copier en `.env.prod` (jamais commité) et renseigner les valeurs vides.
# Le même fichier sert à Docker Compose (--env-file) ET au conteneur PHP
# (env_file).

# Domaine public. BABY_KREBS_DOMAIN sert aux labels Traefik du compose (ici
# et dans baby-krebs-client) ; le même domaine est repris plus bas.
BABY_KREBS_DOMAIN=baby-footenor.tenorsolutions.com

APP_NAME="Baby FooTenor"
APP_ENV=production
# Générée à l'étape 3 du DEPLOY.md.
APP_KEY=
APP_DEBUG=false
APP_URL=https://baby-footenor.tenorsolutions.com
# URL du SPA (même domaine) : cible des redirections après connexion SSO.
FRONTEND_URL=https://baby-footenor.tenorsolutions.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Postgres PARTAGÉ du projet `infra`. Créer la base et le rôle sur la VM,
# depuis /srv/infra : ./scripts/create-database.sh babykrebs
DB_CONNECTION=pgsql
DB_HOST=infra-postgres
DB_PORT=5432
DB_DATABASE=babykrebs
DB_USERNAME=babykrebs
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# Domaine unique, requêtes same-origin : garde-fous.
SANCTUM_STATEFUL_DOMAINS=baby-footenor.tenorsolutions.com
CORS_ALLOWED_ORIGINS=https://baby-footenor.tenorsolutions.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# SSO Microsoft (Entra ID) : voir DEPLOY.md, étape « Connexion Microsoft ».
# Cette URI EXACTE doit être déclarée dans l'inscription d'application Azure.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=https://baby-footenor.tenorsolutions.com/api/auth/microsoft/callback
