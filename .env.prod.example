# Copier en `.env.prod` (jamais commité) et renseigner les valeurs vides.
# Le même fichier sert à Docker Compose (--env-file) ET au conteneur PHP
# (env_file).

# Domaine public : à remplacer PARTOUT dans ce fichier (baby.example.fr).
# BABY_KREBS_DOMAIN sert aussi aux labels Traefik du compose, ici
# et dans baby-krebs-client.
BABY_KREBS_DOMAIN=baby.example.fr

APP_NAME="Baby Krebs"
APP_ENV=production
# Générée à l'étape 3 du DEPLOY.md.
APP_KEY=
APP_DEBUG=false
APP_URL=https://baby.example.fr

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Postgres PARTAGÉ du projet `infra`. Créer la base et le rôle sur la VM,
# depuis /srv/infra : ./scripts/create-database.sh babykrebs
DB_CONNECTION=pgsql
DB_HOST=infra-postgres
DB_PORT=5432
DB_DATABASE=babykrebs
DB_USERNAME=babykrebs
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# Domaine unique, requêtes same-origin : garde-fous.
SANCTUM_STATEFUL_DOMAINS=baby.example.fr
CORS_ALLOWED_ORIGINS=https://baby.example.fr

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database
